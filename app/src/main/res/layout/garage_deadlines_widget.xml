<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="13dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="GARAGE" android:textColor="@color/widget_primary" android:textSize="11sp"
        android:letterSpacing="0.2" android:textStyle="bold" />
    <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Prossime scadenze" android:textColor="@color/widget_foreground" android:textSize="21sp"
        android:textStyle="bold" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Le prossime scadenze delle tue auto"
        android:textColor="@color/widget_secondary" android:textSize="12sp" android:layout_marginBottom="8dp" />
    <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp" android:padding="9dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/widget_card_background">
        <ImageView android:id="@+id/widget_icon_1" android:layout_width="40dp"
            android:layout_height="40dp" android:padding="8dp" android:background="@drawable/widget_icon_background"
            android:contentDescription="Categoria scadenza" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/widget_title_1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/widget_foreground" android:textSize="13sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_detail_1" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widget_status_1" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/widget_primary"
            android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="7dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp" android:padding="9dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/widget_card_background">
        <ImageView android:id="@+id/widget_icon_2" android:layout_width="40dp"
            android:layout_height="40dp" android:padding="8dp" android:background="@drawable/widget_icon_background"
            android:contentDescription="Categoria scadenza" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/widget_title_2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/widget_foreground" android:textSize="13sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_detail_2" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widget_status_2" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/widget_primary"
            android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="7dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_3" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="5dp" android:padding="9dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/widget_card_background">
        <ImageView android:id="@+id/widget_icon_3" android:layout_width="40dp"
            android:layout_height="40dp" android:padding="8dp" android:background="@drawable/widget_icon_background"
            android:contentDescription="Categoria scadenza" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/widget_title_3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/widget_foreground" android:textSize="13sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_detail_3" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/widget_secondary" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/widget_status_3" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/widget_primary"
            android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="7dp" />
    </LinearLayout>
</LinearLayout>
